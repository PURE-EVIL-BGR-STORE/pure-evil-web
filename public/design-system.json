{
  "name": "Pure Evil Design System",
  "version": "1.0.0",
  "theme": "Gothic Luxury / Dark Sigilism",
  "colors": {
    "obsidian": {
      "bg": "#050505",
      "bg2": "#0a0a0a",
      "panel": "#0c0c0c",
